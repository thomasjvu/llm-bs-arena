{
  "name": "llm-bullshit",
  "version": "1.0.0",
  "description": "Bullshit-Bench benchmark release for studying LLM deception, asymmetric honesty framing, and instruction compliance",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "type": "module",
  "bin": {
    "llm-bullshit": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/index.js",
    "run:logged": "node scripts/run-cli-with-log.mjs",
    "dev": "tsx --env-file=.env src/index.ts",
    "visualizer": "tsx --env-file=.env src/server.ts",
    "visualizer:mock": "LLM_PROVIDER=mock tsx src/server.ts",
    "server": "npm run visualizer",
    "server:mock": "npm run visualizer:mock",
    "research:dev": "npm --prefix ui/research run dev",
    "research:build:data": "npm --prefix ui/research run build:data",
    "research:check": "npm --prefix ui/research run check",
    "test": "vitest run",
    "lint": "tsc --noEmit && python3 -B -m py_compile analysis/analyze.py analysis/stats.py analysis/plots.py analysis/report.py",
    "check": "npm run lint && npm test && npm run build",
    "audit": "npm audit",
    "python:setup": "python3 -m venv .venv && .venv/bin/python -m pip install -r analysis/requirements.txt",
    "stats": ".venv/bin/python analysis/stats.py --csv-dir logs/csv",
    "plots": ".venv/bin/python analysis/plots.py --csv-dir logs/csv --output-dir results/figures",
    "report": ".venv/bin/python analysis/report.py --csv-dir logs/csv --output results/research_summary.md --figures-dir results/figures",
    "research:brief": "npm start -- analyze --csv && npm run stats && npm run plots && npm run report",
    "benchmark:release": "node --env-file=.env dist/index.js release",
    "arxiv:bundle": "node scripts/prepare-arxiv-bundle.mjs"
  },
  "keywords": [
    "llm",
    "research",
    "deception",
    "game-theory"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "commander": "^11.1.0"
  }
}
