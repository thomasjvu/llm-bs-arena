# LLM Provider (optional: nim, venice, or mock)
# If not set, provider is auto-detected from the available API config
LLM_PROVIDER=nim

# NVIDIA NIM API keys (primary free-tier provider)
# Get yours at https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
# For parallel v3 shards, use one key per global slot (fastest — isolated rate limits).
# Full 16-way launch (4 experiments x 4 shards):
# NVIDIA_API_KEYS=slot0:nvapi-...,slot1:nvapi-...,...,slot15:nvapi-...
# v3:shard pins slot = experiment * shardCount + shardIndex (aliases: slot7, exp1s3, e1s3).
# Exp-0-only shorthand still works: shard0..shard3. In-process 429 rotation if multiple keys share one process.
# Launch all 16 at once: npm run v3:launch-all

# Optional: override base URL for self-hosted/local NIM
# NVIDIA_NIM_BASE_URL=http://localhost:8000/v1

# Venice AI API keys (paid provider)
# LLM_PROVIDER=venice
# VENICE_API_KEYS=acct1:venice-...,acct2:venice-...
# VENICE_API_KEY=venice-...
# VENICE_BASE_URL=https://api.venice.ai/api/v1
# VENICE_TIMEOUT_MS=180000
# VENICE_REASONING_EFFORT=kimi-k2-6:low,minimax-m27:low
# LLM_CONTEXT_BUDGET_TOKENS_VENICE=120000

# Generated-token completion caps (defaults: 4096 for play and challenge)
# LLM_PLAY_MAX_TOKENS=4096
# LLM_CHALLENGE_MAX_TOKENS=4096

# Optional tuning for larger/slower reasoning models
# NVIDIA_NIM_TIMEOUT_MS=180000
# LLM_RECOVERY_WINDOW_MS=36000000
# LLM_RECOVERY_BACKOFF_MS=30000
# TOURNAMENT_GAME_RETRY_DELAY_MS=30000
# TOURNAMENT_MAX_GAME_FAILURES_PER_SLOT=10