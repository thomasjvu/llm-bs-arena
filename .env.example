# LLM Provider (optional: nim, chutes, featherless, or mock)
# If not set, provider is auto-detected from available API keys
LLM_PROVIDER=nim

# NVIDIA NIM API key (primary provider)
# Get yours at https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional: override base URL for self-hosted/local NIM
# NVIDIA_NIM_BASE_URL=http://localhost:8000/v1

# Optional tuning for larger/slower reasoning models
# NVIDIA_NIM_TIMEOUT_MS=180000
# LLM_PLAY_MAX_TOKENS=8192
# LLM_CHALLENGE_MAX_TOKENS=4096
# LLM_RECOVERY_WINDOW_MS=36000000
# LLM_RECOVERY_BACKOFF_MS=30000
# TOURNAMENT_GAME_RETRY_DELAY_MS=30000
# TOURNAMENT_MAX_GAME_FAILURES_PER_SLOT=10

# Chutes API key (optional fallback provider)
# Get yours at https://chutes.ai/
CHUTES_API_TOKEN=your_chutes_token_here

# Featherless AI API key (optional fallback provider)
# Get yours at https://featherless.ai/
FEATHERLESS_API_KEY=your_featherless_key_here
